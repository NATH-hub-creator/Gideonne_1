{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gideonne",
  "version": "0.1.0",
  "identifier": "com.gideonne.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Gideonne",
      "width": 1100,
      "height": 720,
      "minWidth": 800,
      "minHeight": 600,
      "resizable": true,
      "center": true,
      "decorations": true,
      "theme": "Dark"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "shell": { "open": true },
    "fs": { "all": true, "scope": ["$APPDATA/**", "$HOME/.gideonne/**"] }
  }
}
