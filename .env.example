# ============================================================
# Gideonne_1 — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs.
# Ne commitez JAMAIS le fichier .env.
# ============================================================

# --- Choix du moteur LLM ---
# Valeurs : ollama (défaut, gratuit, local) | openai (nécessite une clé API)
MODEL_PROVIDER=ollama

# --- Ollama (moteur local, recommandé) ---
# Assurez-vous qu'Ollama tourne : https://ollama.com
# Téléchargez le modèle avant de démarrer : ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
GIDEONNE_MODEL=llama3

# --- OpenAI (optionnel, requis uniquement si MODEL_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# GIDEONNE_BASE_URL=https://api.openai.com/v1
# GIDEONNE_MODEL=gpt-4o-mini

# --- Paramètres communs ---
GIDEONNE_MAX_TOKENS=2048
GIDEONNE_TEMPERATURE=0.7

# --- Mémoire ---
GIDEONNE_MEMORY_SIZE=20

# --- Logging ---
GIDEONNE_LOG_LEVEL=INFO
# GIDEONNE_LOG_FILE=logs/gideonne.log
